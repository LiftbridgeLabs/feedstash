# Public URL you open the reader at (no trailing slash). The Google redirect URI
# must be exactly  <BASE_URL>/auth/callback
BASE_URL=http://localhost:8651

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in. Comma separated. At least one of these must be set.
ALLOWED_EMAILS=you@gmail.com
ALLOWED_DOMAINS=

# Signs session cookies. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty a key is generated and stored in the data volume.
SECRET_KEY=

# How often feeds are polled, and how long articles are kept (starred ones are kept forever).
REFRESH_INTERVAL_MINUTES=15
RETENTION_DAYS=90

# Local testing only: skip Google and sign in as a local user. NEVER enable on a reachable server.
DEV_LOGIN=false
