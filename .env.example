# Copy to .env and fill in. Only BASE_URL really matters; everything else has a sensible default.

# The address you open FeedStash at (no trailing slash). Sign-in redirects and secure cookies depend on it.
BASE_URL=http://localhost:8672

# ---- Sign-in: turn on any combination --------------------------------------------------------------
# Passwords. The first visit asks you to create the admin account; add more under Settings -> Accounts.
PASSWORD_LOGIN=true

# Google. Authorized redirect URI:  <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any OpenID Connect provider (Authentik, Authelia, Keycloak, Pocket ID...). Redirect URI:  <BASE_URL>/auth/oidc/callback
# OIDC_ISSUER is the provider's issuer URL, or the full URL of its /.well-known/openid-configuration document.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=single sign-on

# Who may sign in with Google or OIDC. Password accounts are always allowed. Comma separated;
# ALLOWED_EMAILS=* lets in anyone your provider lets through.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# ---- Container ------------------------------------------------------------------------------------
# The user and group FeedStash runs as, which should own a bind-mounted data folder (unRAID: 99 and 100).
PUID=1000
PGID=1000

# Signs session cookies. Leave empty to generate one in the data folder on first start.
SECRET_KEY=

# The image trusts X-Forwarded-* headers from any address, which is right behind a reverse proxy. If the
# container's port is reachable without going through the proxy, set this to the proxy's IP address.
# FORWARDED_ALLOW_IPS=*

# ---- Feeds ----------------------------------------------------------------------------------------
REFRESH_INTERVAL_MINUTES=15
RETENTION_DAYS=90

# Local testing only: skips sign-in entirely. NEVER enable on a server anyone else can reach.
DEV_LOGIN=false
